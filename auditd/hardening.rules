## auditd rules — hardening.rules
## Deploy: /etc/audit/rules.d/hardening.rules
## Apply:  augenrules --load  (o service auditd reload)
## Ver:    auditctl -l

# ── Configuración global ────────────────────────────────────────────────────
-D
-b 8192
-f 1
--backlog_wait_time 60000

# ── Integridad de archivos críticos del sistema ─────────────────────────────
-w /etc/passwd          -p wa -k identity
-w /etc/shadow          -p wa -k identity
-w /etc/group           -p wa -k identity
-w /etc/gshadow         -p wa -k identity
-w /etc/sudoers         -p wa -k privilege_escalation
-w /etc/sudoers.d/      -p wa -k privilege_escalation
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/            -p wa -k sshd_config
-w /etc/hosts           -p wa -k network_config
-w /etc/resolv.conf     -p wa -k network_config
-w /etc/iptables.rules  -p wa -k firewall
-w /etc/nftables.conf   -p wa -k firewall
-w /etc/pam.d/          -p wa -k pam_config
-w /etc/security/       -p wa -k security_config

# ── Cron y trabajos programados ─────────────────────────────────────────────
-w /etc/cron.d/         -p wa -k cron
-w /etc/cron.daily/     -p wa -k cron
-w /etc/cron.weekly/    -p wa -k cron
-w /etc/cron.monthly/   -p wa -k cron
-w /etc/crontab         -p wa -k cron
-w /var/spool/cron/     -p wa -k cron

# ── Módulos del kernel ────────────────────────────────────────────────────────
-w /sbin/insmod         -p x -k kernel_modules
-w /sbin/rmmod          -p x -k kernel_modules
-w /sbin/modprobe       -p x -k kernel_modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules

# ── Escalada de privilegios ───────────────────────────────────────────────────
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid -F exit=0 -F auid>=1000 -F auid!=-1 -k privilege_escalation
-w /usr/bin/sudo        -p x -k privilege_escalation
-w /usr/bin/su          -p x -k privilege_escalation
-w /bin/su              -p x -k privilege_escalation

# ── Acceso a datos sensibles ─────────────────────────────────────────────────
-a always,exit -F arch=b64 -S open,openat,creat -F exit=-EACCES -F auid>=1000 -k unauthorized_access
-a always,exit -F arch=b64 -S open,openat,creat -F exit=-EPERM  -F auid>=1000 -k unauthorized_access

# ── Ejecución de comandos (execve) ───────────────────────────────────────────
# Solo usuarios no-root para evitar ruido; ajustar si se necesita root también
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=-1 -k exec_user
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=-1 -k exec_user

# ── Conexiones de red salientes (detección de shells reversas) ───────────────
-a always,exit -F arch=b64 -S connect -F auid>=1000 -k net_connect_user
-a always,exit -F arch=b64 -S connect -F auid=0     -k net_connect_root

# ── Docker — socket y daemon ─────────────────────────────────────────────────
-w /var/run/docker.sock  -p rwxa -k docker_socket
-w /usr/bin/docker       -p x    -k docker_exec
-w /usr/bin/dockerd      -p x    -k docker_exec
-w /etc/docker/          -p wa   -k docker_config

# ── Binarios del sistema — escritura (detección de backdoors) ────────────────
-w /usr/bin/    -p wa -k bin_modification
-w /usr/sbin/   -p wa -k bin_modification
-w /bin/        -p wa -k bin_modification
-w /sbin/       -p wa -k bin_modification

# ── Herramientas de reconocimiento usadas por atacantes ─────────────────────
-w /usr/bin/whoami     -p x -k recon
-w /usr/bin/id         -p x -k recon
-w /bin/uname          -p x -k recon
-w /usr/bin/net        -p x -k recon
-w /usr/bin/nmap       -p x -k recon
-w /usr/bin/netcat     -p x -k recon
-w /usr/bin/nc         -p x -k recon
-w /usr/bin/curl       -p x -k recon
-w /usr/bin/wget       -p x -k recon

# ── Acceso a logs del sistema (detección de borrado de huellas) ──────────────
-w /var/log/           -p wa -k log_tamper
-w /var/log/auth.log   -p wa -k log_tamper
-w /var/log/syslog     -p wa -k log_tamper

# ── Autenticación ────────────────────────────────────────────────────────────
-w /var/log/faillog     -p wa -k auth
-w /var/log/lastlog     -p wa -k auth
-w /var/run/faillock/   -p wa -k auth

# ── Inmutabilidad (debe ir siempre al final) ─────────────────────────────────
-e 2
