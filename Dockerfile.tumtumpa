FROM python:3.12-slim

WORKDIR /app_escuchowsky

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY .collections_ignore .
COPY app_discover.py .
COPY sops_env.py .

# La DB se monta como volumen en runtime
ENV PYTHONUNBUFFERED=1

EXPOSE 5001

# gunicorn: 2 procesos x 4 threads = 8 requests concurrentes
# --timeout 1800: SSE streams de scrobbles para usuarios con 2000+ páginas (400k tracks)
# toman ~600-1000s; 1800 es el límite real, por encima del timeout de nginx (600s)
CMD ["gunicorn", \
     "-w", "2", \
     "--threads", "4", \
     "-b", "0.0.0.0:5001", \
     "--timeout", "4200", \
     "--forwarded-allow-ips", "172.20.0.10", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "app_discover:app"]
